# Normalize line endings so behavior is identical on Windows and CI runners.
* text=auto

# Shell scripts MUST stay LF — CRLF breaks gradlew on Linux (GitHub Actions)
gradlew text eol=lf
android/gradlew text eol=lf
*.sh text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf

# Never touch binary files
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.tflite binary
*.pt binary
