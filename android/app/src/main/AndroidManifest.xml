<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera permission: required for CameraX live preview and ImageAnalysis -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Feature declaration: app requires a camera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MeshSightApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshSight"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MeshSight"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown for any unrecoverable error. Not exported: only this app can
             reach it, and only from its own crash handler. -->
        <activity
            android:name=".ErrorActivity"
            android:exported="false"
            android:label="Error"
            android:theme="@style/Theme.MeshSight"
            android:screenOrientation="portrait" />

    </application>

</manifest>