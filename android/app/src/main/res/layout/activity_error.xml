<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen crash explanation: what happened, a copyable report, and
     restart / close actions. Deliberately plain so it renders even when the
     crash came from the theming or view code itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1512"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Something went wrong"
        android:textColor="#F2F7F3"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MeshSight hit an unexpected error. The details below are safe to copy and share if you report the issue."
        android:textColor="#93A199"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="#16211C"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Error details"
                android:textColor="#F2F7F3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_btn"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Copy"
                android:textColor="#BCFF5F"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvErrorReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#93A199"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_btn"
            android:text="Close app"
            android:textColor="#C2CEC6" />

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_btn"
            android:text="Restart"
            android:textColor="#0D1512"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
